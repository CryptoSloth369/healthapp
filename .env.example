# Copy to .env.local and fill in from Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used later for the photo calorie estimator (server-side only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=

# Food database search (free key: https://fdc.nal.usda.gov/api-key-signup); falls back to DEMO_KEY
USDA_API_KEY=
