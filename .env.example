# Copy to .env.local for local development. In Vercel, set the same names under
# Settings → Environment Variables. "Config" = plain value, "Secret" = hidden.

# ── Required ─────────────────────────────────────────────
# Supabase → Project Settings → Data API (URL, no path) and API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co        # Config
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx          # Config

# ── Photo estimator + AI coach ───────────────────────────
ANTHROPIC_API_KEY=                                               # Secret

# ── Food database search (free key: https://fdc.nal.usda.gov/api-key-signup)
# Falls back to USDA's rate-limited DEMO_KEY when empty.
USDA_API_KEY=                                                    # Secret

# ── Push reminders (generate all three in the app: Profile → Reminders → Generate keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                                    # Config
VAPID_PRIVATE_KEY=                                               # Secret
CRON_SECRET=                                                     # Secret (also pasted into supabase/reminders-schedule.sql)
